# Browser-visible URL; never put credentials in VITE_* variables.
# Default: same-origin reverse proxy. For separate origins, use an absolute URL
# ending in /api/v1 and allow the UI origin with backend AIGC_CORS_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Development/preview proxy target and UI listener (not embedded in browser JS).
# These can also be supplied as process environment variables.
AIGC_API_URL=http://127.0.0.1:8189
AIGC_UI_URL=http://127.0.0.1:4173
