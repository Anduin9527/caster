    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
