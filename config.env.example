# 复制为 config.env 后填写本地配置（该文件不入 Git）。
# 格式：AIGC_NAME=value；带空格的值使用引号，不使用 shell 命令或变量展开。
# 命令行参数或显式进程环境变量可覆盖本地默认值。
# 可用进程环境变量 AIGC_CONFIG_FILE 指向其他配置文件；默认读取根目录 config.env。
AIGC_API_URL=http://127.0.0.1:8189
AIGC_COMFY_URL=http://127.0.0.1:8188
AIGC_UI_URL=http://127.0.0.1:4173
AIGC_DATA_DIR=data

# 可选 LLM 配置，默认关闭
AIGC_LLM_ENDPOINT=
AIGC_LLM_MODEL=
AIGC_LLM_API_KEY=

# Agent（助手侧栏）模型连接。优先级：显式进程环境变量 > 数据目录下的可编辑
# 连接文件 > 本文件 > 内置默认值。密钥请优先通过界面保存，落在 data/agent/，
# 权限 0600 且不入 Git；本文件仅用于固定部署环境的启动配置。
AIGC_AGENT_ENABLED=1
AIGC_AGENT_BASE_URL=
AIGC_AGENT_API_KEY=
AIGC_AGENT_MODEL=
AIGC_AGENT_PROVIDER=custom
# 单轮工具调用上限与模型超时（秒）
AIGC_AGENT_MAX_TOOL_ROUNDS=8
AIGC_AGENT_TIMEOUT=90

# 本地 RAG：索引在项目同级 caster-rag/ 工作区，Qdrant 只绑回环。
# AIGC_RAG_DIR 为空表示语义检索未部署，检索会明确报告"不可用"而不是少返回结果。
AIGC_RAG_DIR=
AIGC_RAG_QDRANT_URL=http://127.0.0.1:6333
AIGC_RAG_WIKI_ALIAS=wiki
AIGC_RAG_TEMPLATE_ALIAS=templates
AIGC_RAG_MODEL_KEY=qwen3-embedding-0.6b
AIGC_RAG_DIM=1024
AIGC_RAG_MAX_LENGTH=2048
AIGC_RAG_INSTRUCTION=
AIGC_RAG_INDEX_VERSION=index-v2
AIGC_RAG_CPU_THREADS=16
# Wiki 分支在按 source 聚合前向 Qdrant 取的候选点数（每命中一条取多少倍）。
# Wiki 一个条目占多个点（按 chunk），池子太窄会丢掉该条目最匹配的那个 chunk。
AIGC_RAG_WIKI_OVERFETCH=50
# 对整句可精确映射的中文标签（如“旗袍”）增加一条英文标签 Qwen 查询，
# 再用 RRF 与原查询融合。只做整句匹配；宽泛子串扩展实测会降低质量。
AIGC_RAG_EXACT_TAG_EXPANSION=1
# 整句安全名称解析依赖带 names 表的 wiki-bodies.sqlite3。新环境应先构建并验证目录，
# 再启用该开关。
AIGC_RAG_EXACT_RESOLVER=0
# 在线编码器默认使用 CPU；有独立预算时可显式设置 cuda:0。
# 没有卡、没有驱动或显存空闲不足 2 GB 时自动退回 CPU 并在 /agent/index/status 说明。
AIGC_RAG_DEVICE=cpu
