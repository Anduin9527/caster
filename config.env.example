# 复制为 config.env 后填写本地配置（该文件不入 Git）。
# 格式：AIGC_NAME=value；带空格的值使用引号，不使用 shell 命令或变量展开。
# 命令行参数或显式进程环境变量可覆盖本地默认值。
AIGC_API_URL=http://127.0.0.1:8189
AIGC_COMFY_URL=http://127.0.0.1:8188
AIGC_UI_URL=http://127.0.0.1:4173
AIGC_DATA_DIR=data

# 可选 LLM 配置，默认关闭
AIGC_LLM_ENDPOINT=
AIGC_LLM_MODEL=
AIGC_LLM_API_KEY=
