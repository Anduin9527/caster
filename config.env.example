# CASTER 配置模板
# 复制此文件为 config.env 并填入实际值
# config.env 已被 .gitignore 忽略，不会提交到 Git

# ComfyUI 服务地址（本地开发默认值）
AIGC_COMFY_URL=http://127.0.0.1:8188

# 数据目录（SQLite、模板缓存、生成资产）
AIGC_DATA_DIR=/path/to/data

# 日志级别（DEBUG, INFO, WARNING, ERROR）
AIGC_LOG_LEVEL=INFO

# LLM 接入（暂未启用，保留接口）
# LLM endpoint includes /v1; do not commit actual secrets.
AIGC_LLM_ENDPOINT=
AIGC_LLM_MODEL=
AIGC_LLM_API_KEY=

# 可选：SSH 隧道配置（如果 ComfyUI 在远程服务器）
# 在 scripts/tunnel.sh 中使用，不要在此文件中写 IP
# REMOTE_HOST=your-server-hostname
# REMOTE_PORT=8188
# LOCAL_PORT=8188
